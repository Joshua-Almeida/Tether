# Copy to `.env` in this folder (repo root). Never commit `.env`.
# The API boots without keys; ingest/ask return a clear error until you paste them.

# FastRouter (OpenAI-compatible chat). Used for grade / rewrite / generate when set.
FASTROUTER_API_URL=https://api.fastrouter.ai/api/v1
FASTROUTER_API_KEY=
FASTROUTER_LLM_MODEL=openai/gpt-4o-mini

# OpenAI. Used for chat when FastRouter is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Dense retrieve + ingest. Default: same gateway as chat (FastRouter if that key is set).
# FastRouter serves text-embedding-3-small. Leave EMBEDDING_* override empty unless you
# want OpenAI embeddings while chat stays on FastRouter:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Bind these in scripts/dev-api.ps1 (uvicorn --host / --port).
API_HOST=127.0.0.1
API_PORT=8765
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Local Chroma (gitignored). Path is relative to the repo root.
CHROMA_DIR=backend/data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_K=6
RETRIEVE_MODE=hybrid
REWRITE_MAX=1
GRADE_RELEVANCE_THRESHOLD=0.5
