# Copy to `.env` in this folder (repo root). Never commit `.env`.
# The app boots without keys; ask/ingest fail with a clear error until you paste them.

# FastRouter (OpenAI-compatible). Preferred if set.
FASTROUTER_API_URL=https://api.fastrouter.ai/api/v1
FASTROUTER_API_KEY=
FASTROUTER_LLM_MODEL=openai/gpt-4o-mini

# Direct OpenAI (used when FastRouter key is empty)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embeddings go through the same compatible endpoint
EMBEDDING_MODEL=text-embedding-3-small

# Backend
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# RAG
CHROMA_DIR=backend/data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_K=6
REWRITE_MAX=1
GRADE_RELEVANCE_THRESHOLD=0.5
